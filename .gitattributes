* text=auto

# Keep shell and build inputs reproducible across Windows and Linux.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.svg text eol=lf

# PowerShell is edited and run on Windows.
*.ps1 text eol=crlf

# Binary application and design assets.
*.png binary
*.webp binary
*.ttf binary
*.jar binary
*.zip binary
*.xz binary
*.pdf binary
