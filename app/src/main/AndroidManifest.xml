<?xml version="1.0" encoding="utf-8"?>
<!--
    NEON MAZE — Android manifest

    Scope locks:
      • targetSdk 36 for the current Android toolchain baseline.
      • INTERNET is only for optional HTTPS data updates; VIBRATE is for haptics.
      • No account, analytics, media/storage or broad file permissions.
      • Cleartext traffic is disabled; bundled game content works offline.
      • allowBackup="false" — all data is local and non-backed-up by design.
      • Orientation is not locked. Rotation/recreation mid-run produces
        INTERRUPTED, not FAILED, and the run is not persisted.

    Edge-to-edge note:
      For targetSdk 36 the opt-out attribute windowOptOutEdgeToEdgeEnforcement
      is deprecated and disabled. Insets are handled at runtime in
      MainActivity via WindowCompat / ViewCompat, not in this manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional HTTPS content updates; all game-critical resources are bundled. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Haptics only; no runtime permission prompt is required. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Explicitly declare that the app does not require a touchscreen with
        telephony or other hardware. The game is touch-only, so it must not
        disappear from non-telephony tablets.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NEONMAZE"
        android:usesCleartextTraffic="false">

        <!--
            Single activity. Hosts ScreenUI, GameView, LocalStore and
            FeedbackSystem. Launcher entry, so exported="true" is mandatory.
            No orientation lock or configChanges override is declared:
            the Activity recreates on rotation and the accepted
            INTERRUPTED path.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>